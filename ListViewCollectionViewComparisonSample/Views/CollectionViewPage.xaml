<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ListViewCollectionViewComparisonSample"
             x:Class="ListViewCollectionViewComparisonSample.CollectionViewPage">

    <ContentPage.BindingContext>
        <local:BookInfoRepository />
    </ContentPage.BindingContext>

    <CollectionView x:Name="List"
                    ItemsSource="{Binding BookGroups}"
                    IsGrouped="True"
                    SelectionMode="Multiple">
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate>
                <Grid BackgroundColor="#f2f2f2" Padding="12">
                    <Label Text="{Binding Name}" FontAttributes="Bold" />
                </Grid>
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <SwipeView>
                    <SwipeView.LeftItems>
                        <SwipeItems Mode="Execute">
                            <SwipeItem Text="Favorite"
                                       BackgroundColor="#FFC107"
                                       IconImageSource="star.png"
                                       Command="{Binding BindingContext.FavoriteCommand, Source={x:Reference List}}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.LeftItems>
                    <SwipeView.RightItems>
                        <SwipeItems Mode="Execute">
                            <SwipeItem Text="Delete"
                                       BackgroundColor="#E53935"
                                       IconImageSource="delete.png"
                                       Command="{Binding BindingContext.DeleteCommand, Source={x:Reference List}}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Grid Padding="12" RowDefinitions="Auto,Auto">
                        <Label Text="{Binding BookName}" Grid.Row="0" FontAttributes="Bold" />
                        <Label Text="{Binding BookDescription}" Grid.Row="1" Opacity="0.7" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>